# ============================================================================
# Veriply API Environment Configuration
# ============================================================================
# This file references configuration from the root ../../.env file.
# DO NOT duplicate configuration here - all values inherit from root .env
#
# This file exists for:
# 1. Local development convenience (python-dotenv can load from here)
# 2. Documentation of which variables the API uses
# 3. IDE/editor environment variable hints
# ============================================================================

# INSTRUCTIONS:
# -------------
# Option 1 (Recommended): Use Docker Compose
#   - Docker Compose automatically loads ../../.env
#   - All variables available to the API container
#   - No need to create .env in this directory
#
# Option 2: Local Development (without Docker)
#   - Ensure ../../.env exists (copy from ../../.env.example)
#   - FastAPI settings.py will load from root via python-dotenv
#   - OR: Create symlink: ln -s ../../.env .env (Unix/Mac)
#   - OR: Copy ../../.env to .env (Windows, but risks drift)
#
# WARNING: Do NOT create a separate .env file here with different values!
#          This will cause configuration drift between services.

# ============================================================================
# API-SPECIFIC VARIABLES (all loaded from root ../../.env)
# ============================================================================
#
# The following variables are used by FastAPI and loaded via
# apps/api/app/core/settings.py (Pydantic BaseSettings)
#
# All values come from ../../.env - see that file for configuration.

# Database Configuration
# -----------------------
# DB_HOST                    - PostgreSQL host (Ubuntu server IP or localhost)
# DB_PORT                    - PostgreSQL port (default: 5432)
# DB_NAME                    - Database name (veriply_dev or veriply_prod)
# DB_USER                    - Database username
# DB_PASSWORD                - Database password [REQUIRED]
# POSTGRES_*                 - Legacy variable names (mapped to DB_*)
# → Used to construct DATABASE_URL in settings.py

# Ollama Configuration
# --------------------
# OLLAMA_HOST                - Ollama API endpoint (default: http://localhost:11434)
# OLLAMA_MODEL               - Default model name (default: llama2)
# → Used for LLM inference

# Redis Configuration
# -------------------
# REDIS_HOST                 - Redis host (default: localhost)
# REDIS_PORT                 - Redis port (default: 6379)
# REDIS_PASSWORD             - Redis password (optional)
# → Used for caching and sessions

# JWT & Authentication
# --------------------
# JWT_SECRET                 - Secret key for JWT signing [REQUIRED]
# JWT_ALGORITHM              - JWT algorithm (default: HS256)
# JWT_EXPIRATION_MINUTES     - Token expiration (default: 1440 = 24 hours)
# → Used for authentication tokens

# API Server Configuration
# -------------------------
# API_HOST                   - Bind address (default: 0.0.0.0)
# API_PORT                   - Port number (default: 8000)
# API_WORKERS                - Number of worker processes (default: 4)
# API_RELOAD                 - Auto-reload on code changes (dev: true, prod: false)
# LOG_LEVEL                  - Logging level (debug, info, warning, error, critical)
# → Used by uvicorn server

# CORS Configuration
# ------------------
# CORS_ORIGINS               - Comma-separated allowed origins
# → Allowed origins for CORS policy

# Vector Search
# -------------
# EMBEDDING_MODEL            - Model for vector embeddings
# VECTOR_DIMENSION           - Vector dimension size
# SIMILARITY_THRESHOLD       - Minimum similarity score
# → RAG/semantic search configuration

# File Uploads
# ------------
# MAX_UPLOAD_SIZE_MB         - Maximum file size in MB
# ALLOWED_FILE_TYPES         - Comma-separated file extensions
# UPLOAD_DIR                 - Upload directory path
# → Document upload limits

# Environment
# -----------
# ENVIRONMENT                - Runtime environment (development, staging, production)
# DEBUG                      - Debug mode (true/false)
# → Runtime environment settings

# Observability (Optional)
# -------------------------
# SENTRY_DSN                 - Sentry error tracking DSN
# OTEL_EXPORTER_OTLP_ENDPOINT - OpenTelemetry endpoint
# → Error tracking and monitoring

# ============================================================================
# USAGE IN CODE
# ============================================================================
#
# FastAPI loads these variables via:
#   from app.core.settings import settings
#
# Example usage:
#   db_url = settings.DATABASE_URL
#   ollama_host = settings.OLLAMA_HOST
#   jwt_secret = settings.JWT_SECRET
#
# See apps/api/app/core/settings.py for the complete Settings class.
#
# ============================================================================
