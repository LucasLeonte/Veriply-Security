# FastAPI service environment (example)
# Copy to apps/api/.env and adjust values. Do NOT commit real secrets.
# CRITICAL: All secrets marked [REQUIRED] must be set in production

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veriply
POSTGRES_USER=veriply
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# JWT / Security [REQUIRED]
# CRITICAL: Generate a strong, random secret using:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Minimum 32 characters. Application will not start without this set.
JWT_SECRET=
JWT_ALGORITHM=HS256

# Ollama / Embeddings
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

