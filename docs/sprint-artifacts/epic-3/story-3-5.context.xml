        <relevance>Complete technical specification</relevance>
      </artifact>
    </docs>
  </artifacts>

  <constraints>
    <constraint type="security">Original query encrypted at rest (AES-256)</constraint>
    <constraint type="accuracy">High-confidence detection (99%+ for regex patterns)</constraint>
  </constraints>

  <interfaces>
