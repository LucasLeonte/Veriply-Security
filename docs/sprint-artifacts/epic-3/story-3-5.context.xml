  <story>
    <asA>System</asA>
    <iWant>detect and redact PII from queries before sending to LLM</iWant>
    <soThat>sensitive data is never processed by the AI</soThat>
    <tasks>
      <task group="Backend - PII Detection Service">
        <item>Create PIIRedactionService in apps/api/app/services/pii_service.py</item>
        <item>Method: async def redact_query(query_text) -> RedactedQuery</item>
        <item>Tier 1: Rule-based regex detection for email, phone, SSN, credit card, IP, URL</item>
        <item>Tier 2: ML-based NER detection using Microsoft Presidio for names, context-dependent PII</item>
        <item>Redaction markers: &lt;EMAIL&gt;, &lt;PHONE&gt;, &lt;SSN&gt;, &lt;CREDIT_CARD&gt;, &lt;PERSON&gt;, &lt;IP_ADDRESS&gt;, &lt;URL&gt;</item>
        <item>Encrypt original query with AES-256, store separately</item>
        <item>Return redacted query for LLM + encrypted original for audit</item>
      </task>
      <task group="Backend - Query Storage & Encryption">
        <item>Store original query encrypted in database (encrypted_queries table)</item>
        <item>Store redacted query in queries table (safe for analytics)</item>
        <item>Link original and redacted with query_id</item>
      </task>
      <task group="Testing">
        <item>Test: email addresses redacted correctly</item>
        <item>Test: phone numbers redacted (various formats)</item>
        <item>Test: credit cards redacted (Luhn validation)</item>
        <item>Test: SSN redacted</item>
        <item>Test: Names detected and redacted (Presidio NER)</item>
        <item>Test: Mixed PII in one query handled</item>
      </task>
    </tasks>
  </story>

  <acceptanceCriteria>
    <criterion id="1">
      <title>PII Types Detected</title>
      <given>a query contains PII</given>
      <when>redaction runs</when>
      <then>system detects and redacts: email, phone, credit card, SSN, names, IP addresses, URLs</then>
    </criterion>
    <criterion id="2">
      <title>Redaction Markers</title>
      <given>PII is detected</given>
      <when>redaction is applied</when>
      <then>user@example.com → &lt;EMAIL&gt;, 555-123-4567 → &lt;PHONE&gt;, etc.</then>
    </criterion>
    <criterion id="3">
      <title>Original Query Encrypted</title>
      <given>original query stored</given>
      <when>query is saved</when>
      <then>original stored separately (encrypted AES-256) AND redacted version sent to LLM</then>
    </criterion>
  </acceptanceCriteria>

  <artifacts>
