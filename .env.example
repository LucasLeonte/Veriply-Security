# ============================================================================
# Veriply Environment Configuration
# ============================================================================
# This is the SINGLE SOURCE OF TRUTH for all environment variables.
# Copy this file to .env and configure with your actual values.
# NEVER commit .env to git - it contains secrets!
#
# Usage:
# 1. Copy: cp .env.example .env
# 2. Edit .env with your actual values
# 3. All services (API, Web, Docker) will reference this file
#
# Team Setup (4 Developers + Production Server):
# - Each developer machine needs its own .env file
# - Production server needs its own .env file with production values
# - DB_HOST should point to the centralized Ubuntu server IP
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL on Ubuntu Server)
# ----------------------------------------------------------------------------
# Used by: FastAPI (apps/api), Docker Compose
#
# CENTRALIZED DATABASE SETUP:
# All 4 developers + production connect to ONE PostgreSQL instance
# running on a Linux Ubuntu server.
#
# For Development: Set DB_HOST to shared Ubuntu server IP (e.g., 192.168.1.100)
# For Local Testing: Set DB_HOST=localhost to use local Docker PostgreSQL
# For Production: Same server, different DB_NAME and credentials

DB_HOST=192.168.1.100          # [CHANGE] Ubuntu server IP - request from team lead
DB_PORT=5432
DB_NAME=veriply_dev             # Use veriply_prod for production
DB_USER=veriply_user            # [CHANGE] Request credentials from team lead
DB_PASSWORD=changeme_secure_password    # [REQUIRED] Get from team lead

# Legacy variable names (for backward compatibility)
POSTGRES_HOST=${DB_HOST}
POSTGRES_PORT=${DB_PORT}
POSTGRES_DB=${DB_NAME}
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}

# Full connection string (auto-constructed by FastAPI settings)
# postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ----------------------------------------------------------------------------
# OLLAMA CONFIGURATION (LLM Service)
# ----------------------------------------------------------------------------
# Used by: FastAPI (apps/api)

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2             # Default model to use

# ----------------------------------------------------------------------------
# REDIS CONFIGURATION (Caching & Sessions)
# ----------------------------------------------------------------------------
# Used by: FastAPI (apps/api)

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                  # Optional: set if Redis requires auth

# ----------------------------------------------------------------------------
# JWT & AUTHENTICATION
# ----------------------------------------------------------------------------
# Used by: FastAPI (apps/api)
#
# Generate secure secrets with: 
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
#   OR: openssl rand -hex 32

JWT_SECRET=                      # [REQUIRED] Minimum 32 characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440      # 24 hours

# ----------------------------------------------------------------------------
# NEXTAUTH CONFIGURATION
# ----------------------------------------------------------------------------
# Used by: Next.js (apps/web)
#
# Generate NEXTAUTH_SECRET with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
#   OR: openssl rand -base64 32

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                 # [REQUIRED] Minimum 32 characters

# ----------------------------------------------------------------------------
# NEXT.JS CONFIGURATION
# ----------------------------------------------------------------------------
# Used by: Next.js (apps/web)
#
# NEXT_PUBLIC_* variables are exposed to the browser

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Veriply

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------
# Used by: FastAPI (apps/api)

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true                  # Set to false in production
LOG_LEVEL=info                   # debug, info, warning, error, critical

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----------------------------------------------------------------------------
# VECTOR SEARCH CONFIGURATION
# ----------------------------------------------------------------------------
# Used by: FastAPI (apps/api) - for RAG/semantic search

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384             # Must match embedding model output size
SIMILARITY_THRESHOLD=0.7

# ----------------------------------------------------------------------------
# FILE UPLOAD CONFIGURATION
# ----------------------------------------------------------------------------
# Used by: FastAPI (apps/api)

MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,md
UPLOAD_DIR=./uploads

# ----------------------------------------------------------------------------
# OBSERVABILITY & MONITORING (Optional)
# ----------------------------------------------------------------------------

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090

# ----------------------------------------------------------------------------
# ENVIRONMENT & DEPLOYMENT
# ----------------------------------------------------------------------------

ENVIRONMENT=development          # development, staging, production
DEBUG=true                       # Set to false in production

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Optional - for future email features)
# ----------------------------------------------------------------------------

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@veriply.com

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# NEW DEVELOPER ONBOARDING:
# -------------------------
# 1. Copy this file: cp .env.example .env
# 2. Request DB credentials from team lead:
#    - DB_HOST (Ubuntu server IP)
#    - DB_USER (your database username)
#    - DB_PASSWORD (your database password)
# 3. Generate your own secrets:
#    - JWT_SECRET
#    - NEXTAUTH_SECRET
# 4. Test connection: docker-compose up -d
#
# PRODUCTION DEPLOYMENT:
# ----------------------
# 1. Use production database credentials (DB_NAME=veriply_prod)
# 2. Set ENVIRONMENT=production and DEBUG=false
# 3. Use strong, unique secrets (different from dev!)
# 4. Configure proper CORS_ORIGINS (remove localhost)
# 5. Set up PostgreSQL backups (daily recommended)
# 6. Enable monitoring with SENTRY_DSN
# 7. Restrict DB port 5432 to authorized IPs via firewall
#
# SECURITY CHECKLIST:
# -------------------
# ✓ NEVER commit .env to git (.gitignore blocks it)
# ✓ Use strong passwords (min 16 chars, mixed case, numbers, symbols)
# ✓ Rotate secrets regularly (every 90 days recommended)
# ✓ Use different secrets for dev/staging/prod
# ✓ Restrict DB_HOST firewall to team IPs only
# ✓ Use VPN for remote database access (recommended)
# ✓ Keep .env file permissions restricted (chmod 600 .env)
#
# ============================================================================
