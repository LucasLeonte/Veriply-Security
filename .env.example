# Root environment configuration (example)
# Copy this to .env and adjust values. Do NOT commit real secrets.
# CRITICAL: All secrets marked [REQUIRED] must be set in production

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veriply
POSTGRES_USER=veriply
POSTGRES_PASSWORD=change-me

# Ollama
OLLAMA_HOST=http://localhost:11434

# API
API_PORT=8000
# JWT_SECRET [REQUIRED] - Generate using: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Application will not start without this set. Minimum 32 characters.
JWT_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET [REQUIRED] - Generate using: python -c 'import secrets; print(secrets.token_urlsafe(32))'
NEXTAUTH_SECRET=

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

