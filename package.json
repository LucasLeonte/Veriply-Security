{
    "name": "veriply-monorepo",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "postinstall": "npm run setup:api",
        "setup:api": "if not exist .venv python -m venv .venv && .venv\\Scripts\\pip install -r apps/api/requirements.txt",
        "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
        "dev:web": "npm run dev -w apps/web",
        "dev:api": "cd apps/api && ..\\..\\.venv\\Scripts\\uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
        "test": "npm run test:web && npm run test:api",
        "test:web": "npm run test -w apps/web",
        "test:api": "cd apps/api && ..\\..\\.venv\\Scripts\\pytest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    },
    "dependencies": {
        "@radix-ui/react-select": "^2.2.6",
        "date-fns": "^4.1.0"
    }
}
