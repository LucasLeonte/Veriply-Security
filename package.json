{
  "name": "veriply-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --port 8000"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
